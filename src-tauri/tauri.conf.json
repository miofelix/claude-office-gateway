{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Office Gateway",
  "version": "0.1.0",
  "identifier": "com.miofelix.office-gateway",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:renderer",
    "beforeBuildCommand": "npm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Office Gateway",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "width": 1060,
        "height": 800,
        "minWidth": 780,
        "minHeight": 560,
        "visible": true,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "category": "Productivity",
    "shortDescription": "Connect your model provider to Claude Office add-ins"
  }
}
